// ndgrammar

~WS = [ \t\n\r];
~COMMENT = '/*' ~'*/'* '*/' | '//' ~'\n'* '\n';

STRING = '"' (~["\\] | '\\' .)* '"' | "'" (~['\\] | '\\' .)* "'";
RANGE = '[' (~[\]\\] | '\\' .)* ']';

LEX_IDEN = [A-Z] [A-Za-z0-9_]*;
PARSE_IDEN = [a-z] [A-Za-z0-9_]*;

simple = (
    '<'@lookbehind?
    '~'@negate?
    (group | STRING | RANGE | LEX_IDEN | PARSE_IDEN):match
    ((':' | '@'@flag) PARSE_IDEN:iden)?
    ('?':quantity | [*+]:quantity (':' simple:delimiter)?)?
    '>'@lookahead?
);
// simple {
//   lookbehind: bool,
//   negate: bool,
//   match: group | STRING | RANGE | LEX_IDEN | PARSE_IDEN,
//   flag: bool,
//   iden?: PARSE_IDEN,
//   quantity?: '?' | '*' | '+',
//   delimiter?: simple,
//   lookahead: bool
// }

expr = simple+;
// expr: simple[]

group = '(' expr:branch+:'|' ')' ('%' simple:delimiter)?;
// group {
//   branch: expr[],
//   delimiter?: simple
// }

match = expr:branch+:'|';
// match {
//   branch: expr[]
// }

tokenDef = ('~'@skip)? LEX_IDEN:name (':' LEX_IDEN:overrides)? '=' match:match ';';
// tokenDef {
//   skip: bool,
//   name: LEX_IDEN,
//   overrides?: LEX_IDEN,
//   match: match
// }

parseDef = PARSE_IDEN:name '=' match:match ';';
// parseDef {
//   name: PARSE_IDEN,
//   match: match
// }

stmt = tokenDef | parseDef;
// stmt: tokenDef | parseDef

grammar = ';'* stmt+:';'* ';'* EOF;
// grammar: stmt[]